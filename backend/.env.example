# Required
MISTRAL_KEY=your_mistral_api_key_here
EMAIL=your_email@example.com

# Database
DATABASE_URL=postgresql+asyncpg://geo_user:geo_password@localhost:5432/geo_chat

# Authentication
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Anthropic (enables Claude model in chat)
ANTHROPIC_KEY=your_anthropic_api_key_here

# Optional: LangSmith tracing (zero code changes needed — auto-instruments all chains)
# Sign up at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=geo-survival-analysis
