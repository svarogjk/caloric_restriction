# Python
__pycache__/
**/*.pyc
**/*.pyo
.venv/
**/.venv/

# Environment
.env
.env.*
!.env.example

# Node
node_modules/
frontend/node_modules/

# Build outputs (built inside Docker, not needed in context)
frontend/dist/
frontend/.vite/

# Large runtime data — these are mounted as Railway volumes, never baked in
backend/geo_logs/
backend/platform_mappings/
backend/datasets/
backend/*.db*
# backend/data/ contains rag_index.json (the RAG hash-tracking file).
# It is intentionally excluded: the container creates /app/data/ empty at build
# time (via RUN mkdir -p), and Railway mounts a persistent volume there so the
# index survives redeploys without being baked into the image.
backend/data/
geo_logs/
platform_mappings/
datasets/
data/

# GEO dataset cache files (already inside backend/datasets/, but belt-and-braces)

# Dev/docs
presentations/
scripts/
docs/
*.md
!README.md

# Version control
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
.pytest_cache/
**/.pytest_cache/
htmlcov/
.coverage

# Alembic generated (keep alembic/ source, not caches)
backend/alembic/__pycache__/
